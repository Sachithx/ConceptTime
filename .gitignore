__pycache__/
*.pyc
output/
wandb/
.DS_Store
*.egg-info/
.ipynb_checkpoints/

# Secrets / local env — never commit
*.env
keys.env
.env

# Only Epilepsy (data + checkpoints) ships in GitHub. Every other dataset's
# data AND checkpoints are hosted on the HuggingFace Hub and fetched with
# `python download_data.py`. See README (Datasets).
# Whitelist approach: ignore everything under dataset/ and checkpoints/ except
# Epilepsy, so no large non-Epilepsy file can ever be committed by accident.
dataset/*
!dataset/Epilepsy/
checkpoints/*
!checkpoints/Epilepsy/
